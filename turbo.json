{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/data/packages/data/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      "env": ["ANALYZE", "NEXT_PUBLIC_SITE_URL"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
